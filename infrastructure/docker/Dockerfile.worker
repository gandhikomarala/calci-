FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends     build-essential     libpq-dev     libgomp1     curl     && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml setup.py /app/
RUN pip install --no-cache-dir --upgrade pip setuptools wheel &&     pip install --no-cache-dir -e .

COPY packages /app/packages
COPY ml /app/ml
COPY backend /app/backend
COPY pipelines /app/pipelines
COPY apps /app/apps
COPY configs /app/configs

ENV PYTHONPATH=/app
ENV ENVIRONMENT=production

CMD ["celery", "-A", "apps.worker.celery_app:celery_app", "worker", "--loglevel=info", "--concurrency=4"]
